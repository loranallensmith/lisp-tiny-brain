(defun test-start-scenario-initializes-agent-and-world ()
  (let ((scenario (define-scenario lab-box
                    :facts ((room lab)
                            (container crate)
                            (closed crate)
                            (location crate lab)
                            (object gem)
                            (location gem crate))
                    :observations (lab)
                    :goals ((known (contents crate)))
                    :hypotheses (((contents crate)
                                  (contents crate gem)
                                  0.8)
                                 ((contents crate)
                                  (contents crate empty)
                                  0.2)))))
    (multiple-value-bind (agent world returned-scenario)
        (start-scenario scenario)
      (check (eq returned-scenario scenario))
      (check (find '(object gem) (world-facts world) :test #'term=))
      (check (why agent '(container crate)))
      (check (why agent '(visible crate)))
      (check (member '(contents crate) (agent-unknowns agent) :test #'term=))
      (check (find '(known (contents crate))
                   (agent-goals agent)
                   :key #'goal-desire
                   :test #'term=))
      (check (= (length (agent-hypotheses agent)) 2))
      (check (eql (plan-status
                   (plan-for-goal agent '(known (contents crate))))
                  :ready)))))

