(defun test-opening-container-confirms-compatible-hypothesis ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((key-hypothesis (add-hypothesis agent
                                          '(contents box-1)
                                          '(contents box-1 key-1)
                                          0.7))
          (empty-hypothesis (add-hypothesis agent
                                            '(contents box-1)
                                            '(contents box-1 empty)
                                            0.2))
          (unknown-hypothesis (add-hypothesis agent
                                              '(contents box-1)
                                              '(contents box-1 unknown)
                                              0.1)))
      (open-container agent world 'box-1)
      (check (eql (hypothesis-status key-hypothesis) :confirmed))
      (check (integerp (hypothesis-resolved-at key-hypothesis)))
      (check (eql (hypothesis-status empty-hypothesis) :rejected))
      (check (eql (hypothesis-status unknown-hypothesis) :rejected)))))

