(in-package #:tiny-brain/tests)

(defvar *failures* 0)

(defmacro check (form)
  `(unless ,form
     (incf *failures*)
     (format t "~&FAIL: ~S~%" ',form)))

(defun symbol-name= (left right)
  (and (symbolp left)
       (symbolp right)
       (string= (symbol-name left) (symbol-name right))))

(defun term= (left right)
  (cond
    ((and (consp left) (consp right))
     (and (term= (first left) (first right))
          (term= (rest left) (rest right))))
    ((or (consp left) (consp right))
     nil)
    ((and (symbolp left) (symbolp right))
     (symbol-name= left right))
    (t
     (eql left right))))

(defun test-observing-room-adds-visible-beliefs ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (check (why agent '(room room-1)))
    (check (why agent '(object ball-1)))
    (check (why agent '(color ball-1 red)))
    (check (why agent '(location ball-1 room-1)))))

(defun test-observing-room-does-not-reveal-closed-container-contents ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (check (why agent '(container box-1)))
    (check (member '(contents box-1) (agent-unknowns agent) :test #'term=))
    (check (not (why agent '(object key-1))))
    (check (not (why agent '(location key-1 box-1))))))

(defun test-beliefs-have-provenance ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (let ((belief (why agent '(color ball-1 red))))
      (check belief)
      (check (eql (belief-source belief) :direct-observation))
      (check (= (belief-confidence belief) 1.0))
      (check (integerp (belief-observed-at belief))))))

(defun test-infer-adds-derived-beliefs ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (check (not (why agent '(visible ball-1))))
    (infer agent)
    (check (why agent '(visible ball-1)))
    (check (why agent '(visible box-1)))
    (check (why agent '(object box-1)))))

(defun test-inferred-beliefs-explain-their-premises ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((belief (why agent '(visible ball-1))))
      (check belief)
      (check (eql (belief-source belief) :inference))
      (check (eql (belief-rule belief) :thing-in-observed-room-is-visible))
      (check (member '(location ball-1 room-1)
                     (belief-premises belief)
                     :test #'term=))
      (check (member '(room room-1)
                     (belief-premises belief)
                     :test #'term=)))))

(defun test-inference-does-not-inspect-ground-truth ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (check (not (why agent '(object key-1))))
    (check (not (why agent '(location key-1 box-1))))
    (check (not (why agent '(location key-1 room-1))))))

(defun test-opening-container-requires-access ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (check (not (why agent '(visible box-1))))
    (check (handler-case
               (progn
                 (open-container agent world 'box-1)
                 nil)
             (error ()
               t)))))

(defun test-opening-container-reveals-immediate-contents ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (check (not (why agent '(object key-1))))
    (check (member '(contents box-1) (agent-unknowns agent) :test #'term=))
    (open-container agent world 'box-1)
    (check (why agent '(open box-1)))
    (check (not (why agent '(closed box-1))))
    (check (why agent '(object key-1)))
    (check (why agent '(color key-1 brass)))
    (check (why agent '(location key-1 box-1)))
    (check (not (member '(contents box-1)
                        (agent-unknowns agent)
                        :test #'term=)))))

(defun test-action-observations-have-provenance ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (open-container agent world 'box-1)
    (let ((belief (why agent '(object key-1))))
      (check belief)
      (check (eql (belief-source belief) :action-observation))
      (check (= (belief-confidence belief) 1.0)))))

(defun test-inference-after-opening-uses-new-beliefs ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (open-container agent world 'box-1)
    (check (not (why agent '(location key-1 room-1))))
    (infer agent)
    (let ((belief (why agent '(location key-1 room-1))))
      (check belief)
      (check (eql (belief-source belief) :inference))
      (check (eql (belief-rule belief) :location-through-container)))))

(defun test-suggest-actions-requires-believed-preconditions ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (check (null (suggest-actions agent)))
    (infer agent)
    (check (suggest-actions agent))))

(defun test-suggest-actions-identifies-unknown-reducing-action ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((suggestions (suggest-actions agent)))
      (check (= (length suggestions) 1))
      (let ((suggestion (first suggestions)))
        (check (eql (action-suggestion-action suggestion) 'open-container))
        (check (symbol-name= (action-suggestion-target suggestion) 'box-1))
        (check (term= (action-suggestion-reason suggestion)
                      '(contents box-1)))
        (check (member '(visible box-1)
                       (action-suggestion-preconditions suggestion)
                       :test #'term=))))))

(defun test-suggest-actions-disappears-after-unknown-is-resolved ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (check (suggest-actions agent))
    (open-container agent world 'box-1)
    (check (null (suggest-actions agent)))))

(defun test-exclusive-state-beliefs-retract-conflicts ()
  (let ((agent (make-agent)))
    (add-belief agent '(closed box-1))
    (add-belief agent '(open box-1))
    (check (why agent '(open box-1)))
    (check (not (why agent '(closed box-1))))
    (check (= (length (agent-retractions agent)) 1))
    (let ((retraction (first (agent-retractions agent))))
      (check (term= (retraction-fact retraction) '(closed box-1)))
      (check (eql (retraction-reason retraction)
                  :replaced-by-exclusive-state))
      (check (term= (retraction-replaced-by retraction)
                    '(open box-1))))))

(defun test-exclusive-state-retraction-is-per-object ()
  (let ((agent (make-agent)))
    (add-belief agent '(closed box-1))
    (add-belief agent '(closed box-2))
    (add-belief agent '(open box-1))
    (check (why agent '(open box-1)))
    (check (not (why agent '(closed box-1))))
    (check (why agent '(closed box-2)))))

(defun test-opening-container-records-retraction ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (open-container agent world 'box-1)
    (check (why agent '(open box-1)))
    (check (not (why agent '(closed box-1))))
    (let ((retraction (first (agent-retractions agent))))
      (check retraction)
      (check (term= (retraction-fact retraction) '(closed box-1)))
      (check (term= (retraction-replaced-by retraction)
                    '(open box-1))))))

(defun test-explain-direct-observation ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (let ((explanation (explain agent '(color ball-1 red))))
      (check (term= (explanation-fact explanation)
                    '(color ball-1 red)))
      (check (eql (explanation-status explanation) :believed))
      (check (eql (explanation-source explanation) :direct-observation))
      (check (= (explanation-confidence explanation) 1.0))
      (check (null (explanation-premises explanation))))))

(defun test-explain-inference-chain ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((explanation (explain agent '(visible ball-1))))
      (check (eql (explanation-status explanation) :believed))
      (check (eql (explanation-source explanation) :inference))
      (check (eql (explanation-rule explanation)
                  :thing-in-observed-room-is-visible))
      (check (= (length (explanation-premises explanation)) 2))
      (check (find '(location ball-1 room-1)
                   (explanation-premises explanation)
                   :key #'explanation-fact
                   :test #'term=))
      (check (find '(room room-1)
                   (explanation-premises explanation)
                   :key #'explanation-fact
                   :test #'term=)))))

(defun test-explain-retracted-belief ()
  (let ((agent (make-agent)))
    (add-belief agent '(closed box-1))
    (add-belief agent '(open box-1))
    (let ((explanation (explain agent '(closed box-1))))
      (check (eql (explanation-status explanation) :retracted))
      (check (term= (retraction-fact (explanation-retraction explanation))
                    '(closed box-1)))
      (check (term= (retraction-replaced-by
                     (explanation-retraction explanation))
                    '(open box-1))))))

(defun test-explain-unknown-fact ()
  (let ((agent (make-agent)))
    (let ((explanation (explain agent '(color missing-thing purple))))
      (check (term= (explanation-fact explanation)
                    '(color missing-thing purple)))
      (check (eql (explanation-status explanation) :unknown)))))

(defun test-add-goal-records-active-goal ()
  (let ((agent (make-agent)))
    (let ((goal (add-goal agent '(known (contents box-1)))))
      (check (term= (goal-desire goal) '(known (contents box-1))))
      (check (eql (goal-status goal) :active))
      (check (integerp (goal-created-at goal)))
      (check (member goal (agent-goals agent))))))

(defun test-known-fact-goal-is-satisfied-by-belief ()
  (let ((agent (make-agent)))
    (add-belief agent '(color ball-1 red))
    (let ((goal (add-goal agent '(known (color ball-1 red)))))
      (check (eql (goal-status goal) :satisfied))
      (check (integerp (goal-satisfied-at goal))))))

(defun test-contents-goal-is-satisfied-after-opening-container ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((goal (add-goal agent '(known (contents box-1)))))
      (check (eql (goal-status goal) :active))
      (open-container agent world 'box-1)
      (check (eql (goal-status goal) :satisfied))
      (check (integerp (goal-satisfied-at goal))))))

(defun test-suggestion-can-serve-active-goal ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((goal (add-goal agent '(known (contents box-1)))))
      (let ((suggestion (first (suggest-actions agent))))
        (check suggestion)
        (check (eq (action-suggestion-serves-goal suggestion) goal))))))

(defun test-remove-goal ()
  (let ((agent (make-agent)))
    (add-goal agent '(known (contents box-1)))
    (check (agent-goals agent))
    (remove-goal agent '(known (contents box-1)))
    (check (null (agent-goals agent)))))

(defun test-select-action-prefers-active-goal ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((goal (add-goal agent '(known (contents box-1)))))
      (let ((selection (select-action agent)))
        (check selection)
        (check (eql (selected-action-reason selection)
                    :serves-active-goal))
        (check (eq (action-suggestion-serves-goal
                    (selected-action-suggestion selection))
                   goal))))))

(defun test-select-action-can-pick-curiosity-suggestion ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((selection (select-action agent)))
      (check selection)
      (check (eql (selected-action-reason selection)
                  :reduces-unknown))
      (check (eql (action-suggestion-action
                   (selected-action-suggestion selection))
                  'open-container)))))

(defun test-perform-suggestion-executes-known-action ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (let ((goal (add-goal agent '(known (contents box-1)))))
      (let ((selection (select-action agent)))
        (perform-suggestion agent world (selected-action-suggestion selection))
        (check (why agent '(open box-1)))
        (check (why agent '(object key-1)))
        (check (eql (goal-status goal) :satisfied))))))

(defun test-select-action-returns-nil-without-suggestions ()
  (let ((agent (make-agent)))
    (check (null (select-action agent)))))

(defun test-observe-records-episode ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (check (= (length (agent-episodes agent)) 1))
    (let ((episode (first (agent-episodes agent))))
      (check (eql (episode-type episode) :observation))
      (check (term= (episode-detail episode) '(observe room-1)))
      (check (member '(room room-1)
                     (episode-results episode)
                     :test #'term=))
      (check (member '(color ball-1 red)
                     (episode-results episode)
                     :test #'term=))
      (check (integerp (episode-time episode))))))

(defun test-open-container-records-action-episode ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (open-container agent world 'box-1)
    (check (= (length (agent-episodes agent)) 2))
    (let ((episode (first (agent-episodes agent))))
      (check (eql (episode-type episode) :action))
      (check (term= (episode-detail episode) '(open-container box-1)))
      (check (member '(open box-1)
                     (episode-results episode)
                     :test #'term=))
      (check (member '(object key-1)
                     (episode-results episode)
                     :test #'term=)))))

(defun test-infer-does-not-record-episode-yet ()
  (let ((world (make-world))
        (agent (make-agent)))
    (observe agent world 'room-1)
    (infer agent)
    (check (= (length (agent-episodes agent)) 1))))

(defun run-tests ()
  (setf *failures* 0)
  (test-observing-room-adds-visible-beliefs)
  (test-observing-room-does-not-reveal-closed-container-contents)
  (test-beliefs-have-provenance)
  (test-infer-adds-derived-beliefs)
  (test-inferred-beliefs-explain-their-premises)
  (test-inference-does-not-inspect-ground-truth)
  (test-opening-container-requires-access)
  (test-opening-container-reveals-immediate-contents)
  (test-action-observations-have-provenance)
  (test-inference-after-opening-uses-new-beliefs)
  (test-suggest-actions-requires-believed-preconditions)
  (test-suggest-actions-identifies-unknown-reducing-action)
  (test-suggest-actions-disappears-after-unknown-is-resolved)
  (test-exclusive-state-beliefs-retract-conflicts)
  (test-exclusive-state-retraction-is-per-object)
  (test-opening-container-records-retraction)
  (test-explain-direct-observation)
  (test-explain-inference-chain)
  (test-explain-retracted-belief)
  (test-explain-unknown-fact)
  (test-add-goal-records-active-goal)
  (test-known-fact-goal-is-satisfied-by-belief)
  (test-contents-goal-is-satisfied-after-opening-container)
  (test-suggestion-can-serve-active-goal)
  (test-remove-goal)
  (test-select-action-prefers-active-goal)
  (test-select-action-can-pick-curiosity-suggestion)
  (test-perform-suggestion-executes-known-action)
  (test-select-action-returns-nil-without-suggestions)
  (test-observe-records-episode)
  (test-open-container-records-action-episode)
  (test-infer-does-not-record-episode-yet)
  (if (zerop *failures*)
      (progn
        (format t "~&All tests passed.~%")
        t)
      (progn
        (format t "~&~D test failure~:P.~%" *failures*)
        (uiop:quit 1))))
